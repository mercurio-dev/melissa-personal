import { whatsappUrl } from "@/data/site";
import Icon from "./Icon.astro";
---
<section class="contact" id="contact"><span class="eyebrow">Seu próximo passo</span><h2>Vamos colocar<br>esse corpo em movimento?</h2><p>Converse comigo sobre seus objetivos e descubra como começar pela avaliação.</p><div class="contact-action">{whatsappUrl ? <a class="action" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Agendar uma avaliação pelo WhatsApp <Icon name="arrow-up-right" /></a> : <><button class="action" type="button" disabled>Agendamento em breve</button><p class="contact-note">Em breve, você poderá agendar sua avaliação por aqui.</p></>}</div></section>
